# Which LLM backend: "groq" (cloud, fast, free tier) or "ollama" (local, private, offline)
LLM_BACKEND=groq

# Get a free key at https://console.groq.com — only needed if LLM_BACKEND=groq
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Only used if LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b

# Get a free key at https://tavily.com — needed for web search
TAVILY_API_KEY=your-key-here